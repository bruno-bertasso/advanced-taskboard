{
  "name": "taskboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src e2e",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json && cp src/components/taskboard/taskboard.css dist-lib/theme.css",
    "registry:build": "shadcn build",
    "typecheck": "tsc -b",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "test:storybook": "playwright test -c playwright.storybook.config.ts"
  },
  "dependencies": {
    "@base-ui/react": ">=1.0.0",
    "@dnd-kit/core": ">=6.3.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-virtual": ">=3.10.0",
    "class-variance-authority": ">=0.7.0",
    "clsx": ">=2.0.0",
    "lucide-react": ">=0.400.0",
    "nuqs": ">=2.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "tailwind-merge": ">=2.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^8.0.9",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "http-server": "^14.1.1",
    "oxlint": "^1.89.0",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist-lib"
  ],
  "exports": {
    ".": {
      "types": "./dist-lib/types/components/taskboard/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./theme.css": "./dist-lib/theme.css"
  },
  "peerDependencies": {
    "@base-ui/react": ">=1.0.0",
    "@dnd-kit/core": ">=6.3.0",
    "@tanstack/react-virtual": ">=3.10.0",
    "class-variance-authority": ">=0.7.0",
    "clsx": ">=2.0.0",
    "lucide-react": ">=0.400.0",
    "nuqs": ">=2.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "tailwind-merge": ">=2.0.0"
  }
}
